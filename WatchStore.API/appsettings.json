{
  "Jwt": {
    "Issuer": "WatchStore.API",
    "Audience": "WatchStore.Client",
    "ExpiryMinutes": 120
  },
  "WatchFlow": {
    "BusinessId": 1,
    "SlotIntervalMinutes": 15,
    "MinimumNoticeMinutes": 60,
    "DefaultSearchDays": 7,
    "MaxSearchDays": 14,
    "AlternativesCount": 3
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
